    <item>
      <title>About</title>
      <link>//localhost:1313/about/</link>
      <pubDate>Thu, 28 Feb 2019 00:00:00 +0000</pubDate>
      <guid>//localhost:1313/about/</guid>
      <description>&lt;div class=&#34;fixed-top-menu&#34;&gt;&#xA;  &lt;div class=&#34;fixed-menu-scroll&#34;&gt;&#xA;    &lt;nav id=&#34;TableOfContents&#34;&gt;&#xA;  &lt;ul&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#summary&#34;&gt;Summary&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#professional-skills&#34;&gt;Professional Skills&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#platform-skills&#34;&gt;Platform Skills&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#professional-experience&#34;&gt;Professional Experience&lt;/a&gt;&#xA;      &lt;ul&gt;&#xA;        &lt;li&gt;&lt;a href=&#34;#senior-video--cdn-operationsintegration-engineer&#34;&gt;Senior Video &amp;amp; CDN Operations/Integration Engineer&lt;/a&gt;&lt;/li&gt;&#xA;        &lt;li&gt;&lt;a href=&#34;#video--cdn-operationsintegration-engineer&#34;&gt;Video &amp;amp; CDN Operations/Integration Engineer&lt;/a&gt;&lt;/li&gt;&#xA;        &lt;li&gt;&lt;a href=&#34;#application-operations-specialist&#34;&gt;Application Operations Specialist&lt;/a&gt;&lt;/li&gt;&#xA;        &lt;li&gt;&lt;a href=&#34;#system--database-engineer&#34;&gt;System &amp;amp; Database Engineer&lt;/a&gt;&lt;/li&gt;&#xA;      &lt;/ul&gt;&#xA;    &lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#education&#34;&gt;Education&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#languages&#34;&gt;Languages&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#certifications&#34;&gt;Certifications&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li&gt;&lt;a href=&#34;#courses&#34;&gt;Courses&lt;/a&gt;&lt;/li&gt;&#xA;  &lt;/ul&gt;&#xA;&lt;/nav&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;style&gt;&#xA;  .fixed-top-menu {&#xA;    position: sticky;&#xA;    top: 0;&#xA;    left: 0;&#xA;    right: 0;&#xA;    background: slategrey;&#xA;    border-bottom: 1px solid var(--border);&#xA;    padding: 0.75rem;&#xA;    z-index: 1000;&#xA;    display: flex;&#xA;    align-items: center;&#xA;  }&#xA;&#xA;  .fixed-menu-title {&#xA;    flex-shrink: 0;&#xA;    font-weight: 600;&#xA;    margin-right: 1rem;&#xA;    color: var(--heading);&#xA;    font-size: 0.95rem;&#xA;    padding-right: 1rem;&#xA;    border-right: 1px solid var(--border);&#xA;  }&#xA;&#xA;  .fixed-menu-scroll {&#xA;    flex: 1;&#xA;    overflow-x: auto;&#xA;    padding: 0.25rem 0;&#xA;  }&#xA;&#xA;   &#xA;  .fixed-menu-scroll&gt;ul {&#xA;    display: flex !important;&#xA;    flex-wrap: nowrap !important;&#xA;    gap: 0.5rem !important;&#xA;    margin: 0 !important;&#xA;    padding: 0 !important;&#xA;    list-style: none !important;&#xA;  }&#xA;&#xA;  .fixed-menu-scroll li {&#xA;    margin: 0 !important;&#xA;    padding: 0 !important;&#xA;    flex-shrink: 0 !important;&#xA;  }&#xA;&#xA;   &#xA;  .fixed-menu-scroll a {&#xA;    display: block !important;&#xA;    padding: 0.5rem 1rem !important;&#xA;    background: var(--code-bg) !important;&#xA;    border: 1px solid var(--border) !important;&#xA;    border-radius: 6px !important;&#xA;    color: var(--text) !important;&#xA;    text-decoration: none !important;&#xA;    font-size: 1.3rem !important;&#xA;    font-weight: 600 !important;&#xA;    white-space: nowrap !important;&#xA;    transition: all 0.2s ease !important;&#xA;  }&#xA;&#xA;   &#xA;  .fixed-menu-scroll a:hover {&#xA;    background: var(--primary) !important;&#xA;    color: blue !important;&#xA;    border-color: var(--primary) !important;&#xA;    transform: translateY(-4px) !important;&#xA;    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15) !important;&#xA;  }&#xA;&#xA;   &#xA;  .fixed-menu-scroll&gt;ul&gt;li&gt;a:hover {&#xA;    background: var(--primary) !important;&#xA;    color: white !important;&#xA;    border-color: var(--primary) !important;&#xA;    transform: translateY(-1px) !important;&#xA;    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;&#xA;  }&#xA;&#xA;   &#xA;  .fixed-menu-scroll ul ul {&#xA;    display: none !important;&#xA;  }&#xA;&#xA;   &#xA;  .fixed-menu-scroll::-webkit-scrollbar {&#xA;    height: 4px;&#xA;  }&#xA;&#xA;  .fixed-menu-scroll::-webkit-scrollbar-track {&#xA;    background: var(--bg);&#xA;  }&#xA;&#xA;  .fixed-menu-scroll::-webkit-scrollbar-thumb {&#xA;    background: var(--border);&#xA;    border-radius: 2px;&#xA;  }&#xA;&#xA;   &#xA;  body {&#xA;    padding-top: 60px !important;&#xA;  }&#xA;&#xA;  h2 {&#xA;    scroll-margin-top: 70px;&#xA;    padding-top: 70px;&#xA;    margin-top: -50px;&#xA;  }&#xA;&#xA;   &#xA;  @media (max-width: 768px) {&#xA;    .fixed-top-menu {&#xA;      padding: 0.5rem;&#xA;    }&#xA;&#xA;    .fixed-menu-title {&#xA;      font-size: 0.85rem;&#xA;      margin-right: 0.75rem;&#xA;      padding-right: 0.75rem;&#xA;    }&#xA;&#xA;    .fixed-menu-scroll a {&#xA;      padding: 0.4rem 0.75rem !important;&#xA;      font-size: 0.8rem !important;&#xA;    }&#xA;&#xA;    body {&#xA;      padding-top: 50px !important;&#xA;    }&#xA;&#xA;    h2 {&#xA;      scroll-margin-top: 60px;&#xA;      padding-top: 60px;&#xA;      margin-top: -40px;&#xA;    }&#xA;  }&#xA;&lt;/style&gt;&#xA;&#xA;&lt;script&gt;&#xA;  &#xA;  document.addEventListener(&#39;DOMContentLoaded&#39;, function () {&#xA;    const menuScroll = document.querySelector(&#39;.fixed-menu-scroll&#39;);&#xA;    if (!menuScroll) return;&#xA;&#xA;    &#xA;    const topUl = menuScroll.querySelector(&#39;ul&#39;);&#xA;    if (!topUl) return;&#xA;&#xA;    &#xA;    const nestedUls = topUl.querySelectorAll(&#39;ul&#39;);&#xA;    nestedUls.forEach(ul =&gt; ul.remove());&#xA;&#xA;    &#xA;    const allLis = topUl.querySelectorAll(&#39;li&#39;);&#xA;    allLis.forEach(li =&gt; {&#xA;      &#xA;      const nestedLis = li.querySelectorAll(&#39;li&#39;);&#xA;      nestedLis.forEach(nestedLi =&gt; nestedLi.remove());&#xA;&#xA;      &#xA;      const links = li.querySelectorAll(&#39;a&#39;);&#xA;      if (links.length &gt; 1) {&#xA;        for (let i = 1; i &lt; links.length; i++) {&#xA;          links[i].remove();&#xA;        }&#xA;      }&#xA;    });&#xA;&#xA;    &#xA;    topUl.style.display = &#39;flex&#39;;&#xA;    topUl.style.flexWrap = &#39;nowrap&#39;;&#xA;    topUl.style.gap = &#39;0.5rem&#39;;&#xA;    topUl.style.margin = &#39;0&#39;;&#xA;    topUl.style.padding = &#39;0&#39;;&#xA;    topUl.style.listStyle = &#39;none&#39;;&#xA;&#xA;    &#xA;    const lis = topUl.querySelectorAll(&#39;li&#39;);&#xA;    lis.forEach(li =&gt; {&#xA;      li.style.margin = &#39;0&#39;;&#xA;      li.style.padding = &#39;0&#39;;&#xA;      li.style.flexShrink = &#39;0&#39;;&#xA;    });&#xA;&#xA;    &#xA;    const links = topUl.querySelectorAll(&#39;a&#39;);&#xA;    links.forEach(link =&gt; {&#xA;      link.style.display = &#39;block&#39;;&#xA;      link.style.padding = &#39;0.5rem 1rem&#39;;&#xA;      link.style.background = &#39;var(--code-bg)&#39;;&#xA;      link.style.border = &#39;1px solid var(--border)&#39;;&#xA;      link.style.borderRadius = &#39;6px&#39;;&#xA;      link.style.color = &#39;var(--text)&#39;;&#xA;      link.style.textDecoration = &#39;none&#39;;&#xA;      link.style.fontSize = &#39;0.85rem&#39;;&#xA;      link.style.fontWeight = &#39;500&#39;;&#xA;      link.style.whiteSpace = &#39;nowrap&#39;;&#xA;      link.style.transition = &#39;all 0.2s ease&#39;;&#xA;&#xA;      &#xA;      link.addEventListener(&#39;mouseenter&#39;, function () {&#xA;        this.style.background = &#39;var(--primary)&#39;;&#xA;        this.style.color = &#39;white&#39;;&#xA;        this.style.borderColor = &#39;var(--primary)&#39;;&#xA;        this.style.transform = &#39;translateY(-1px)&#39;;&#xA;        this.style.boxShadow = &#39;0 2px 8px rgba(0,0,0,0.15)&#39;;&#xA;      });&#xA;&#xA;      link.addEventListener(&#39;mouseleave&#39;, function () {&#xA;        this.style.background = &#39;var(--code-bg)&#39;;&#xA;        this.style.color = &#39;var(--text)&#39;;&#xA;        this.style.borderColor = &#39;var(--border)&#39;;&#xA;        this.style.transform = &#39;translateY(0)&#39;;&#xA;        this.style.boxShadow = &#39;none&#39;;&#xA;      });&#xA;    });&#xA;  });&#xA;&lt;/script&gt;&#xA;&lt;hr&gt;&#xA;&lt;h2 id=&#34;summary&#34;&gt;&#xA;  Summary&#xA;  &lt;a class=&#34;heading-link&#34; href=&#34;#summary&#34;&gt;&#xA;    &lt;i class=&#34;fa-solid fa-link&#34; aria-hidden=&#34;true&#34; title=&#34;Link to heading&#34;&gt;&lt;/i&gt;&#xA;    &lt;span class=&#34;sr-only&#34;&gt;Link to heading&lt;/span&gt;&#xA;  &lt;/a&gt;&#xA;&lt;/h2&gt;&#xA;&lt;p&gt;Highly experienced System Administrator with &lt;strong&gt;17+&lt;/strong&gt; years of expertise in designing, deploying, and managing complex server infrastructures from bare metal to top-level applications. Skilled in Linux, Open Source Intelligence, and Video Streaming Services, with a strong proficiency in automation tools like Ansible, Puppet, and Terraform.&lt;/p&gt;</description>
    </item>
